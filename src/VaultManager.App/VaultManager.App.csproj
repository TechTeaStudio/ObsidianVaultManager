<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == ''">net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <!-- A publish for a runtime is always net10.0. With the full list, its restore would download runtime packs of every framework here. -->
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' != ''">net10.0</TargetFrameworks>
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
    <AssemblyName>VaultManager</AssemblyName>
    <RootNamespace>VaultManager.App</RootNamespace>
    <!-- net6.0 is out of support; the build keeps it on purpose (v0.2.0.0). -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\vault-manager.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Desktop Linux does not always ship ICU: on an Ubuntu without it the build crashed at its first database call.
    Invariant mode needs no ICU, and PredefinedCulturesOnly=false still lets the Russian strings load by name.
  -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <InvariantGlobalization>true</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VaultManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

<ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.14" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.14" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.14" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.14" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VaultManager.Core\VaultManager.Core.csproj" />
  </ItemGroup>
</Project>
